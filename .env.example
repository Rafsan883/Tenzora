# Backend: npm run dev:all supplies an isolated database and fresh secrets.
# Set these when running individual services or deploying them.
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Public SPA origin used for OAuth completion redirects. Set this explicitly in Render.
OAUTH_FRONTEND_URL=http://localhost:5173
SITE_URL=http://localhost:5173
PORT=5001
CHAT_PORT=8080
COMMENT_PORT=4000
WT_PORT=8081
MONGO_URI=mongodb://127.0.0.1:27017/anixo
JWT_SECRET=
INTERNAL_SERVICE_SECRET=
CRON_SECRET=
ONLINE_SERVER_URL=http://localhost:7861
PROXY_ALLOWED_HOSTS=
GOOGLE_CLIENT_ID=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=http://localhost:5001/auth/anilist/callback
RESEND_API_KEY=
RESEND_FROM=
EMAIL_FROM=
GROQ_API_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Pages runtime routing (separate from the frontend base URL)
BACKEND_API_URL=
METADATA_API_URL=

# Phase 8–10 catalog freshness and analytics
# Render/backend URL that owns the normalized SEO catalog.
SEO_CATALOG_API_URL=
# Set the same strong value in Render, the Cloudflare Worker secret store,
# and the metadata API runtime for INTERNAL_SERVICE_SECRET above. Do not place
# it in VITE_* or wrangler vars.
